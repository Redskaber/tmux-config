# @layout: monitor
# @author: redskaber
# @description: System monitoring — 2x2 grid of watch panes
# @panes: 4
# @tags: ops, monitoring, sysadmin

LAYOUT_NAME="monitor"
LAYOUT_DESC="Top | Logs | Network | Disk"
LAYOUT_PANES=4

layout_apply() {
  local session="$1"
  local window="$2"

  # Split into 2 columns
  tmux split-window -h -p 50 -t "${session}:${window}.1"
  # Left column: split into 2 rows
  tmux split-window -v -p 50 -t "${session}:${window}.1"
  # Right column: split into 2 rows
  tmux split-window -v -p 50 -t "${session}:${window}.2"

  tmux select-pane -t "${session}:${window}.1"
}
